{
  "name": "dsh-steer-note",
  "version": "0.1.1",
  "description": "A compact mid-turn steering box for DeepSeek Harness with text and images, read receipts, and unfinished-draft rescue.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "steer",
    "steering"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hffek/dsh-steer-note.git"
  },
  "homepage": "https://github.com/hffek/dsh-steer-note#readme",
  "bugs": {
    "url": "https://github.com/hffek/dsh-steer-note/issues"
  }
}
